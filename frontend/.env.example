# Frontend Environment Variables Template
# Duplicate this file as .env.local for local development, or configure these variables in Vercel.

# API Base URL:
# For Local Development (Vite dev proxy default is /api when left blank or set to http://localhost:8000/api):
VITE_API_URL=http://localhost:8000/api

# For Production (Point to your deployed PHP backend API URL):
# VITE_API_URL=https://your-backend-domain.com/api
